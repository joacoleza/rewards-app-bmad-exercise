{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:unit": {
      "dependsOn": ["build"]
    },
    "test:e2e": {},
    "test:ci": {
      "dependsOn": ["build"]
    },
    "//#update-badges": {
      "dependsOn": ["test"],
      "cache": false
    }
  }
}
